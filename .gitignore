# Generated by Cargo
# will have compiled files and executables
# No trailing slash: a trailing slash matches only a directory, and a
# developer may symlink target/ onto another disk. Without this, `git status`
# reports the symlink as untracked and it can be committed by accident,
# putting a machine-specific absolute path into a public repo.
/target

# These are backup files generated by rustfmt
**/*.rs.bk

# `otto Graph` output (GraphFormat::Png/Svg)
*.png
*.svg

# Example generated files - ignore common output files from Otto examples
examples/*/some-file
examples/*/*.o
examples/*/*.exe
examples/*/myapp
examples/*/app
examples/*/program
examples/*/*.log
examples/*/line_count.txt
examples/*/summary_output.txt
examples/*/test_results.log
examples/*/deployment.log
examples/*/build/
examples/*/dist/
examples/*/target/

# tarpaulin coverage reports
lcov.info
tarpaulin-report.html
examples/_test_broken/

# cargo-mutants working output (see bin/mutants-gate)
/mutants.out/
