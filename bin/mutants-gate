#!/usr/bin/env bash
#
# Fail the build when a NEW surviving mutant appears.
#
# A surviving ("missed") mutant is a change to production code that no test
# distinguishes from the original: cargo-mutants edited a function to return a
# different value, reran the whole suite, and everything stayed green. That is
# the machine-checkable definition of the defect this audit kept finding by
# hand - a test that passes for a reason unrelated to the behavior it claims to
# pin. Five were found that way over fourteen batches, and the handoff's advice
# to the next reviewer was to assume a sixth. This replaces the assuming.
#
# The gate is a ratchet, not a clean-sheet requirement. `mutants-baseline.txt`
# records the survivors that already existed when this was introduced; the build
# fails only on survivors that are not in it. Shrinking the baseline is a
# reviewable diff. Growing it is too, and that is the point: it cannot happen
# silently, which is exactly how the five got in.
#
# Usage:
#   bin/mutants-gate              # gate against the committed baseline
#   bin/mutants-gate --write      # regenerate the baseline from this run
#   bin/mutants-gate -- <args>    # pass extra args through to cargo mutants
#                                 # e.g. --file src/executor/scheduler.rs

set -euo pipefail

cd "$(dirname "$0")/.."

BASELINE="mutants-baseline.txt"
OUT_DIR="mutants.out"
WRITE=0

extra=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --write) WRITE=1; shift ;;
        --) shift; extra=("$@"); break ;;
        *) extra+=("$1"); shift ;;
    esac
done

if ! command -v cargo-mutants >/dev/null 2>&1; then
    echo "mutants-gate: cargo-mutants is not installed (cargo install cargo-mutants)" >&2
    exit 127
fi

# The ratchet's scope, unless the caller named files explicitly.
SCOPE="mutants-scope.txt"
scope_args=()
if [[ ! " ${extra[*]+"${extra[*]}"} " =~ " --file " ]]; then
    if [[ ! -f "$SCOPE" ]]; then
        echo "mutants-gate: $SCOPE is missing; it defines which files the ratchet covers" >&2
        exit 1
    fi
    while IFS= read -r line; do
        [[ -z "$line" || "$line" == \#* ]] && continue
        if [[ ! -f "$line" ]]; then
            # A scope entry naming a file that no longer exists would silently
            # shrink coverage, which is the failure mode this whole gate is for.
            echo "mutants-gate: $SCOPE names '$line', which does not exist" >&2
            exit 1
        fi
        scope_args+=(--file "$line")
    done < "$SCOPE"
    if [[ ${#scope_args[@]} -eq 0 ]]; then
        echo "mutants-gate: $SCOPE lists no files; the gate would pass without testing anything" >&2
        exit 1
    fi
    echo "mutants-gate: scope is $((${#scope_args[@]} / 2)) file(s) from $SCOPE"
fi

echo "mutants-gate: running cargo mutants (this is slow; it reruns the suite once per mutant)"

# cargo-mutants exits non-zero when mutants survive, which is the normal case
# here - the baseline decides whether that is a failure. Capture the code
# immediately; anything between the command and `$?` loses it.
set +e
cargo mutants --output "$OUT_DIR" "${scope_args[@]+"${scope_args[@]}"}" "${extra[@]+"${extra[@]}"}"
mutants_rc=$?
set -e

# `cargo mutants --output DIR` writes its results to DIR/mutants.out, one level
# down from DIR itself. Reading DIR/missed.txt finds nothing and, without the
# existence check below, would have read as "no mutants survived".
RESULTS="$OUT_DIR/mutants.out"
MISSED="$RESULTS/missed.txt"
if [[ ! -f "$MISSED" ]]; then
    # No missed.txt means cargo-mutants did not get far enough to produce a
    # verdict. That is a real failure, not an empty survivor set: treating a
    # missing file as "nothing survived" is precisely the shape of criterion
    # that cannot fail.
    echo "mutants-gate: $MISSED does not exist; cargo mutants exited $mutants_rc without producing a verdict" >&2
    exit 1
fi

# Existence is not enough, and this gate proved it on itself. A run killed
# part-way through leaves all four outcome files present and EMPTY, and an
# earlier version of this script read that as "nothing survived" and passed - the
# exact defect class it was written to eliminate. The verdict is only meaningful
# if the outcomes account for the mutants cargo-mutants said it would test.
outcome_total=0
for outcome in caught missed timeout unviable; do
    f="$RESULTS/$outcome.txt"
    [[ -f "$f" ]] || { echo "mutants-gate: $f does not exist; the run produced no verdict" >&2; exit 1; }
    outcome_total=$(( outcome_total + $(wc -l < "$f") ))
done

if [[ "$outcome_total" -eq 0 ]]; then
    echo "mutants-gate: the run tested ZERO mutants. That is a failure, not a pass." >&2
    echo "  cargo mutants exited $mutants_rc. Check $RESULTS/debug.log - a killed or timed-out" >&2
    echo "  run leaves every outcome file present and empty." >&2
    exit 1
fi

# Reconcile against cargo-mutants' own total. If the outcomes do not add up, the
# run did not finish, however it exited.
#
# Read from outcomes.json, not from the console log. The first version of this
# grepped debug.log for "Found N mutants to test", a string that is not in it -
# so `found` was always empty, the comparison was always skipped, and the check
# could never fire. A check that cannot fire is the same defect this whole gate
# exists to catch, and it is the third time in this audit that a grep looking in
# the wrong place read as a clean result. Hence: a structured field, and a hard
# failure when it is absent rather than a skip.
OUTCOMES="$RESULTS/outcomes.json"
if [[ ! -f "$OUTCOMES" ]]; then
    echo "mutants-gate: $OUTCOMES does not exist; cannot confirm the run was complete" >&2
    exit 1
fi

found=$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["total_mutants"])' "$OUTCOMES" 2>/dev/null || true)
if [[ -z "$found" ]]; then
    echo "mutants-gate: $OUTCOMES has no total_mutants field; cannot confirm the run was complete" >&2
    exit 1
fi

if [[ "$outcome_total" -ne "$found" ]]; then
    echo "mutants-gate: incomplete run. cargo-mutants found $found mutants but only $outcome_total have outcomes." >&2
    echo "  A partial run cannot clear the gate; rerun without a wall-clock cap." >&2
    exit 1
fi

echo "mutants-gate: $outcome_total of $found mutants accounted for"

# Sorted so the comparison is order-independent; cargo-mutants does not promise
# a stable order between runs.
sort -u "$MISSED" > "$RESULTS/missed.sorted"

if [[ "$WRITE" == "1" ]]; then
    cp "$RESULTS/missed.sorted" "$BASELINE"
    echo "mutants-gate: baseline written to $BASELINE ($(wc -l < "$BASELINE") surviving mutants)"
    exit 0
fi

if [[ ! -f "$BASELINE" ]]; then
    echo "mutants-gate: $BASELINE is missing. Create it with: bin/mutants-gate --write" >&2
    exit 1
fi

sort -u "$BASELINE" > "$RESULTS/baseline.sorted"

# Lines in this run's survivors that are not in the baseline.
new_survivors=$(comm -23 "$RESULTS/missed.sorted" "$RESULTS/baseline.sorted" || true)
# Lines in the baseline that no longer survive: progress, reported so the
# baseline can be tightened.
fixed=$(comm -13 "$RESULTS/missed.sorted" "$RESULTS/baseline.sorted" || true)

if [[ -n "$fixed" ]]; then
    echo
    echo "mutants-gate: these baseline entries no longer survive. Tighten the baseline:"
    echo "$fixed" | sed 's/^/  - /'
fi

if [[ -n "$new_survivors" ]]; then
    echo
    echo "mutants-gate: FAILED. New surviving mutants - production code changed here and every test stayed green:"
    echo "$new_survivors" | sed 's/^/  + /'
    echo
    echo "Each line is a real gap: write a test that fails when that mutation is applied."
    echo "If the mutation is genuinely not worth pinning, add the line to $BASELINE with a reason in the commit message."
    exit 1
fi

echo
echo "mutants-gate: OK. $(wc -l < "$RESULTS/missed.sorted") surviving mutants, all known to $BASELINE."
